<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cấu hình log cho phần mềm quản lý BHYT.
  - Appender SYSTEM: log hệ thống chung (root logger).
  - Appender OPERATION: nhật ký thao tác nghiệp vụ (logger tên "operation",
    dùng bởi AuditLogService).
  Cú pháp rolling policy theo Logback 1.5+ (Spring Boot 3.3): dùng
  SizeAndTimeBasedRollingPolicy, không còn SizeAndTimeBasedFNATP.
-->
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Log ra console (tiện khi phát triển) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Log hệ thống -->
    <appender name="SYSTEM" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/bhyt_system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/bhyt_system_%d{ddMMyyyy}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <totalSizeCap>200MB</totalSizeCap>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Nhật ký thao tác nghiệp vụ -->
    <appender name="OPERATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/bhyt_operation.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/bhyt_operation_%d{ddMMyyyy}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <totalSizeCap>200MB</totalSizeCap>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SYSTEM"/>
    </root>

    <logger name="operation" level="INFO" additivity="false">
        <appender-ref ref="OPERATION"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

</configuration>
